# Crossfit team — variables de entorno
# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` está en .gitignore: nunca commitees credenciales.

# ---------------------------------------------------------------------------
# Firebase — client SDK (browser)
# Console → Configuración del proyecto → Tus apps → App web → SDK setup
# Sólo se usa para el login (email/password + Google). Son valores públicos:
# la seguridad real la dan las reglas de Firestore y el custom claim de admin.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase — admin SDK (servidor)
# Console → Configuración del proyecto → Cuentas de servicio → Generar clave
# privada. Del JSON que descarga salen estos tres campos.
# SECRETO: da acceso total a la base, que además es COMPARTIDA con otro proyecto.
# Los mismos tres valores los usan los scripts `npm run admin:grant|revoke`.
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# La clave va entre comillas y con los saltos de línea escapados como \n:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=
